<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.fengling.mapper.ChapterMapper">
    <select id="getChapterListByBookId" resultType="com.fengling.entity.dto.ChapterListRespDto">
        select
            bc.id,
            bc.chapter_name as chapterName
        from book_chapter as bc
        where book_id = #{bookId}
        order by chapter_num asc;
    </select>
</mapper>
